# Copy this file to .env.local and fill in values. Never commit .env.local.

# PostgreSQL (with pgvector extension). Matches docker-compose.yml defaults.
DATABASE_URL=postgresql://tracevault:tracevault@127.0.0.1:55432/tracevault

# Secret used to sign login tokens. Generate with: openssl rand -base64 32
AUTH_SECRET=change-me

# Embedding provider (decide model in Phase 0; dimension must match VECTOR(n) in DDL)
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
OLLAMA_BASE_URL=http://localhost:11434
# Maximum wait for an Ollama embedding response (milliseconds)
OLLAMA_TIMEOUT_MS=30000

# Optional override for the model written by npm run ml:train.
# INCIDENT_MODEL_PATH=.models/incident-model.json

# Independent signing root for the alert receiver. Use at least 32 random characters.
TRACEPREDICT_WEBHOOK_SECRET=
