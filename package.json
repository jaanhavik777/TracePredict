{
  "name": "tracepredict",
  "version": "0.1.0",
  "private": true,
  "description": "TracePredict: Incident Triage, Investigation and Resolution Intelligence",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:init": "tsx scripts/init-db.ts",
    "db:migrate": "tsx scripts/init-db.ts --migrate",
    "db:deploy": "tsx scripts/init-db.ts --deploy",
    "ops:demo": "tsx scripts/seed-ops.ts",
    "ops:send-demo": "tsx scripts/send-demo-alerts.ts",
    "ops:worker": "tsx scripts/ops-worker.ts",
    "ops:test": "tsx --test tests/ops.test.ts",
    "ops:test:api": "node --test tests/ops-api.test.mjs",
    "product:test": "node --test tests/product-api.test.mjs",
    "ml:export": "tsx ml/export.ts",
    "ml:train": "tsx ml/train.ts",
    "ml:test": "tsx --test tests/prediction.test.ts",
    "db:setup": "bash scripts/setup-db.sh",
    "db:reset": "bash scripts/reset-db.sh",
    "test:all": "bash scripts/run-tests.sh",
    "demo:reset": "bash scripts/demo-reset.sh",
    "embeddings:backfill": "tsx scripts/backfill-embeddings.ts",
    "db:vector-index": "bash scripts/apply-vector-index.sh"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.6",
    "next": "^15.0.0",
    "pg": "^8.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "postcss": "8.5.23"
  }
}
